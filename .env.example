# Copy to .env (git-ignored). lib.sh loads it before every step.

# Apple Developer team ID (10 characters, Membership page in developer.apple.com)
APPLE_TEAM_ID=
# App Store Connect API key: Users and Access > Integrations > App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
# Path to the AuthKey_<ASC_KEY_ID>.p8 file (default: ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8)
ASC_KEY_PATH=
# Distribution certificate ID in App Store Connect (default: read from $SIGNING_DIR/cert-id.txt)
ASC_CERT_ID=
# Folder holding dist.p12, p12.pw, wwdr_G3.cer, wwdr_G6.cer (default: ~/.appstoreconnect/signing)
SIGNING_DIR=
# Optional: internal TestFlight group name and tester added when the group is first created
TESTFLIGHT_GROUP_NAME=
TESTFLIGHT_TESTER_EMAIL=
TESTFLIGHT_TESTER_FIRST=
TESTFLIGHT_TESTER_LAST=
